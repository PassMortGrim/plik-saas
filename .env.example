# Copier ce fichier en .env, remplir les valeurs, puis : chmod 600 .env
# Le .env est exclu par .gitignore : ne JAMAIS le commiter.
# deploy.sh génère ce fichier automatiquement avec des secrets aléatoires.

# Domaine public (Caddy/TLS) — utilisé par docker-compose pour Caddy
DOMAIN=plik.exemple.fr

# Token d'administration de la passerelle (min 32 caractères)
# Générer avec : openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_GENERATED_BY_DEPLOY

# Passerelle
PLIK_URL=http://plik:8080
PUBLIC_BASE_URL=https://plik.exemple.fr
API_URL=http://127.0.0.1:8080

# Limites globales (octets / secondes)
MAX_FILE_BYTES=214748364800
MAX_TTL_SECONDS=2592000

# Object Storage Scaleway (S3)
SCW_ACCESS_KEY=CHANGE_ME
SCW_SECRET_KEY=CHANGE_ME
SCW_BUCKET=plik-saas
SCW_REGION=fr-par
