;; plikd.cfg — configuration Plik, générée par deploy.sh depuis ce template.
;;
;; Format PLAT identique au plikd.cfg officiel du dépôt Plik
;; (https://github.com/root-gg/plik/blob/master/server/plikd.cfg),
;; validé contre le code source de Plik 1.4.x.
;;
;; Sécurité : après substitution ce fichier contient les secrets S3.
;; Il est exclu par .gitignore et chmod 600 par deploy.sh : ne JAMAIS le commiter.

Debug               = false
LogLevel            = "INFO"

ListenPort          = 8080
ListenAddress       = "0.0.0.0"

;; Pas d'interface web : accès uniquement via la passerelle (réseau backend).
NoWebInterface      = true
PlikDomain          = ""
DownloadDomain      = ""

;; TLS est terminé par Caddy en amont.
AssumeHTTPS         = false

;; 220 Go (décimal) : marge au-dessus du plafond passerelle (200 Gio = 214,7 Go).
MaxFileSizeStr      = "220GB"
MaxFilePerUpload    = 100

;; Mêmes bornes que la passerelle (défaut 1 h, plafond 30 jours).
DefaultTTLStr       = "1h"
MaxTTLStr           = "720h"

;; Multi-tenancy, quotas et auth : gérés par la passerelle, PAS par Plik.
FeatureAuthentication = "disabled"
FeatureOneShot        = "enabled"
FeatureRemovable      = "enabled"
FeatureStream         = "enabled"
FeatureSetTTL         = "enabled"

;; Plik n'est joignable que depuis le réseau Docker backend.
UploadWhitelist      = []

DataBackend = "s3"

[DataBackendConfig]
    ;; Endpoint SANS schéma (https implicite via UseSSL).
    Endpoint        = "__SCW_ENDPOINT__"
    AccessKeyID     = "__SCW_ACCESS_KEY__"
    SecretAccessKey = "__SCW_SECRET_KEY__"
    Bucket          = "__SCW_BUCKET__"
    Location        = "__SCW_REGION__"
    Prefix          = ""
    UseSSL          = true
    ;; 20 MiB par part : 20 000 parts max côté S3 → 200 Gio par fichier,
    ;; au-dessus des 10 000 parts S3 avec le défaut 16 MiB (~160 Gio seulement).
    PartSize        = 20971520
    PartUploadConcurrency = 4

[MetadataBackendConfig]
    Driver = "sqlite3"
    ;; Relatif au répertoire du serveur Plik (/home/plik/server),
    ;; donc dans le volume persistant plik-data monté sur .../data.
    ConnectionString = "data/plik.db"
